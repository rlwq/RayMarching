cabal-version:      3.0
name:               RayMarching
version:            0.1.0.0
license:            MIT
license-file:       LICENSE
author:             Karnavski S.
maintainer:         carnavschii2007@gmail.com
category:           Graphics
build-type:         Simple

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:  Vec
                      Transform
                      SDF
                      Ray
                      Camera
                      March
    build-depends:    base ^>=4.18.3.0, contravariant ^>=1.5.6
    hs-source-dirs:   src
    default-language: Haskell2010

executable RayMarching
    import:           warnings
    main-is:          Main.hs
    build-depends:    base ^>=4.18.3.0, RayMarching
    hs-source-dirs:   app
    default-language: Haskell2010
